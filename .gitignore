# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/front/node_modules
/front/.pnp
/front/pnp.*
/front/.yarn/*
!/front/.yarn/patches
!/front/.yarn/plugins
!/front/.yarn/releases
!/front/.yarn/versions

# testing
/front/coverage

# next.js
/front/.next/
/front/out/

# production
/front/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
