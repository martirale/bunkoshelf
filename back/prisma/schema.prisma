generator client {
  provider = "prisma-client-js"
  output   = "./node_modules/.pnpm/@prisma/client"
}


datasource db {
  provider = "sqlite"
  url      = "file:./data.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  name      String?
  lastname  String?
}
