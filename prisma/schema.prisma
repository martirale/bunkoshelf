generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Users
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  username  String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  name      String?
  lastname  String?
  birthYear Int?

  seriesProgress   UserToSeries[]
  volumeProgress   UserToVolume[]
  ReadingChallenge ReadingChallenge[]
  DailyReadingLog  DailyReadingLog[]
  PushSubscription PushSubscription[]
}

model ReadingChallenge {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  year     Int
  goal     Int
  notified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

// Library Status
model UserToSeries {
  id         String      @id @default(cuid())
  user       User        @relation(fields: [userId], references: [id])
  userId     String
  series     MangaSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId   String
  isFavorite Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, seriesId])
}

model UserToVolume {
  id       String      @id @default(cuid())
  user     User        @relation(fields: [userId], references: [id])
  userId   String
  volume   MangaVolume @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  volumeId String

  isRead     Boolean @default(false)
  isFavorite Boolean @default(false)

  lastPage   Int?
  totalPages Int?
  lastReadAt DateTime?
  firstRead  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, volumeId])
}

model DailyReadingLog {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  date      String
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Manga Library
model MangaSeries {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  path      String
  isOneshot Boolean  @default(false)
  mtime     DateTime @default(now())
  status    String   @default("ONGOING")

  metadataObj SeriesMetadata? @relation(fields: [metadataId], references: [id], onDelete: SetNull)
  metadataId  String?         @unique

  volumes       MangaVolume[]
  genres        SeriesToGenre[]
  usersProgress UserToSeries[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MangaVolume {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  filename   String
  fullPath   String
  size       Int      @default(0)
  mtime      DateTime @default(now())
  coverImage String?

  series   MangaSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId String

  metadataObj VolumeMetadata? @relation(fields: [metadataId], references: [id], onDelete: SetNull)
  metadataId  String?         @unique

  genres VolumeToGenre[]
  tags   VolumeToTag[]

  usersProgress UserToVolume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FileChecksum {
  id        String   @id @default(cuid())
  filePath  String?  @unique
  checksum  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Manga Metadata
model VolumeMetadata {
  id       String @id @default(cuid())
  filePath String @unique

  series String?
  title  String?
  number Float?
  count  Int?

  publisher   String?
  languageISO String?
  ageRating   String?

  writer      String?
  penciller   String?
  inker       String?
  colorist    String?
  letterer    String?
  coverArtist String?
  editor      String?
  translator  String?

  summary String?
  web     String?

  year  Int?
  month Int?
  day   Int?

  gtin       String?
  mangaStyle String?

  mangaVolume MangaVolume? @relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeriesMetadata {
  id         String @id @default(cuid())
  folderPath String @unique

  series      String?
  summary     String?
  publisher   String?
  genre       String?
  languageISO String?
  writer      String?
  artist      String?

  mangaSeries MangaSeries? @relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Genres and Tags
model Genre {
  id      String          @id @default(cuid())
  name    String          @unique
  volumes VolumeToGenre[]
  series  SeriesToGenre[]
}

model Tag {
  id      String        @id @default(cuid())
  name    String        @unique
  volumes VolumeToTag[]
}

model VolumeToGenre {
  id       String      @id @default(cuid())
  volume   MangaVolume @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  volumeId String
  genre    Genre       @relation(fields: [genreId], references: [id])
  genreId  String

  @@unique([volumeId, genreId])
}

model VolumeToTag {
  id       String      @id @default(cuid())
  volume   MangaVolume @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  volumeId String
  tag      Tag         @relation(fields: [tagId], references: [id])
  tagId    String

  @@unique([volumeId, tagId])
}

model SeriesToGenre {
  id       String      @id @default(cuid())
  series   MangaSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId String
  genre    Genre       @relation(fields: [genreId], references: [id])
  genreId  String

  @@unique([seriesId, genreId])
}
